MARK_PORT=3100
MARK_DATA_HOST_DIR=./data
MARK_SECURE_COOKIE=0
MARK_SYNC_INTERVAL_MINUTES=60

# Optional Authentik OIDC. Leave all blank to retain password-only login.
# When enabled, set MARK_SECURE_COOKIE=1. The first five values are required.
MARK_OIDC_ISSUER=
MARK_OIDC_CLIENT_ID=
MARK_OIDC_CLIENT_SECRET_FILE=
MARK_OIDC_CALLBACK_URL=
MARK_OIDC_OWNER_SUBJECT=
# NAS: trust the Work-OS private CA and resolve only the issuer to loopback.
MARK_OIDC_CA_FILE=
MARK_OIDC_RESOLVE_ADDRESS=

# Ask is optional. Set all three values for a provider that needs an API key.
MARK_MODEL_BASE_URL=
MARK_MODEL_NAME=
MARK_MODEL_API_KEY=
